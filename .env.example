# Where the language model runs when the app opens: "groq" (cloud) or "ollama" (private, on this computer).
# You can switch in the toolbar, but the app returns to this choice each time it opens.
LLM_PROVIDER=groq

# Set to false to remove Groq from the app entirely, so nothing can reach the cloud.
# ALLOW_CLOUD=false

# Groq: get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional model overrides
# GROQ_SMART_MODEL=openai/gpt-oss-120b
# GROQ_FAST_MODEL=openai/gpt-oss-20b

# Ollama: run `ollama pull gemma4:e4b` first
# OLLAMA_MODEL=gemma4:e4b
# OLLAMA_BASE_URL=http://127.0.0.1:11434
